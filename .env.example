# Copy to .env (git-ignored)

# Signs login sessions and form tokens. Generate:
# Linux/macOS: .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(48))"
# Windows: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=

# The MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trading_db
DB_USER=trading_app
DB_PASSWORD=

# Encrypts SSNs and bank account numbers. Generate:
# Linux/macOS: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Windows: .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe
FIELD_ENCRYPTION_KEY=

# The first administrator. Passowrd needs at least 12 characters
ADMIN_EMAIL=
ADMIN_PASSWORD=
